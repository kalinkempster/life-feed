{
  "name": "life-of-k-squared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A Claude-curated feed. The site is the reading room; feed.json is the machine interface.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "node --env-file-if-exists=.env generator/run.mjs",
    "generate:dry": "node --env-file-if-exists=.env generator/run.mjs --dry-run",
    "rebuild": "node --env-file-if-exists=.env generator/run.mjs --no-curate",
    "verify": "node --env-file-if-exists=.env generator/verify-feed.mjs",
    "test": "node generator/selftest.mjs",
    "seed": "node generator/seed-archive.mjs",
    "verify:live": "node --env-file-if-exists=.env generator/verify-feed.mjs --live",
    "verify:links": "node --env-file-if-exists=.env generator/verify-feed.mjs --links",
    "library": "node --env-file-if-exists=.env generator/library-probe.mjs",
    "publish:checked": "node generator/publish-checked.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "zod": "^4.0.0"
  }
}
