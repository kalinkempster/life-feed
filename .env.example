# Curation. Required for a real run; --no-curate rebuilds without it.
#
# Leave this COMMENTED OUT rather than blank if you authenticate with an
# `ant auth login` profile instead. An empty ANTHROPIC_API_KEY still wins its
# precedence slot over the profile and authenticates with an empty key — the
# request fails with an auth error that looks nothing like the actual cause.
# ANTHROPIC_API_KEY=sk-ant-...

# Record library (curation/library.md). Optional: a failed read falls back to
# curation/.library-cache.json and reports the staleness on /status.
NOTION_TOKEN=
NOTION_LIBRARY_DB=      # the Vinyls database id — see curation/library.md

# Dismissal signals. Optional: without these the generator publishes without
# read-state and /api/signal accepts and discards.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# The public origin. Everything self-referential in the feed is built from this.
SITE_ORIGIN=https://life-of-kk.vercel.app

# Publish _homepage.signals_url in feed.json. Leave unset until /api/signal is
# deployed and answering 202 — the contract's default (absent = the dashboard
# keeps dismissals local) is correct until then, and publishing a dead URL means
# every dismissal is fired into a wall and silently swallowed.
SIGNALS_ENABLED=
